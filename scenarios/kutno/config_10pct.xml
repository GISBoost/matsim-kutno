<?xml version="1.0" ?>
<!DOCTYPE config SYSTEM "http://www.matsim.org/files/dtd/config_v2.dtd">
<!-- F5: run integracyjny 10% (D8). Ścieżki względne do tego pliku. Wejścia: F2 network, F4 plans. -->
<config>
	<module name="global">
		<param name="randomSeed" value="4711" />
		<param name="coordinateSystem" value="EPSG:2180" />
		<param name="numberOfThreads" value="8" />
	</module>
	<module name="network">
		<param name="inputNetworkFile" value="network.xml.gz" />
	</module>
	<module name="plans">
		<param name="inputPlansFile" value="plans.xml.gz" />
	</module>
	<module name="controller">
		<!-- UWAGA: MATSim rozwiązuje outputDirectory względem katalogu roboczego, nie configu. Uruchamiaj z katalogu projektu. -->
		<param name="outputDirectory" value="output/f5_10pct" />
		<param name="lastIteration" value="20" />
		<param name="overwriteFiles" value="deleteDirectoryIfExists" />
	</module>
	<module name="qsim">
		<!-- D8: przepustowość skalowana do frakcji próbki -->
		<param name="flowCapacityFactor" value="0.1" />
		<param name="storageCapacityFactor" value="0.1" />
		<!-- wyjazdy do 23:59 (GBR Rys. 46, ostatni przedział) + 8 h pracy + dojazd -->
		<param name="endTime" value="36:00:00" />
		<param name="numberOfThreads" value="8" />
	</module>
	<module name="scoring">
		<!-- ZAŁOŻENIE: domyślne MATSim, bez openingTime (są zmiany nocne). Score tylko diagnostyczny (DECISIONS: otwarte). -->
		<parameterset type="activityParams">
			<param name="activityType" value="home" />
			<param name="typicalDuration" value="16:00:00" />
		</parameterset>
		<parameterset type="activityParams">
			<param name="activityType" value="work" />
			<param name="typicalDuration" value="08:00:00" />
		</parameterset>
	</module>
	<module name="replanning">
		<!-- Bez TimeAllocationMutator: godziny wyjazdu pochodzą ze źródła (D10) i nie mają dryfować. -->
		<parameterset type="strategysettings">
			<param name="strategyName" value="ChangeExpBeta" />
			<param name="weight" value="0.8" />
		</parameterset>
		<parameterset type="strategysettings">
			<param name="strategyName" value="ReRoute" />
			<param name="weight" value="0.2" />
		</parameterset>
		<param name="fractionOfIterationsToDisableInnovation" value="0.8" />
	</module>
</config>
